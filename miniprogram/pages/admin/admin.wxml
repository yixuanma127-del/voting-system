<view class="page">
  <!-- 子标签切换 -->
  <view class="sub-tabs">
    <view 
      class="sub-tab {{activeTab === 'manage' ? 'active' : ''}}"
      data-tab="manage"
      bindtap="switchTab"
    >作品管理</view>
    <view 
      class="sub-tab {{activeTab === 'results' ? 'active' : ''}}"
      data-tab="results"
      bindtap="switchTab"
    >结果详情</view>
    <view 
      class="sub-tab {{activeTab === 'awards' ? 'active' : ''}}"
      data-tab="awards"
      bindtap="switchTab"
    >颁奖典礼</view>
  </view>

  <!-- ========== 作品管理 ========== -->
  <view class="tab-content" wx:if="{{activeTab === 'manage'}}">
    
    <!-- 投票链接 -->
    <view class="link-card">
      <text class="link-label">📱 投票页面链接</text>
      <view class="link-row">
        <input class="link-input" value="{{voteUrl}}" disabled />
        <button class="copy-btn" bindtap="copyUrl">复制</button>
      </view>
    </view>

    <!-- 操作栏 -->
    <view class="action-bar">
      <button class="action-btn add" bindtap="showAddModal">
        ➕ 添加作品
      </button>
      <button class="action-btn reset" bindtap="resetAll">
        🔄 重置投票
      </button>
    </view>

    <!-- 作品列表 -->
    <view class="manage-list" wx:if="{{!loading && works.length > 0}}">
      <view wx:for="{{works}}" wx:key="id" class="manage-item">
        <image class="manage-img" src="{{item.image_data}}" mode="aspectFill" />
        <view class="manage-info">
          <text class="manage-title">{{item.title}}</text>
          <text class="manage-author" wx:if="{{item.author}}">{{item.author}}</text>
        </view>
        <button 
          class="del-btn"
          data-id="{{item.id}}"
          data-title="{{item.title}}"
          bindtap="confirmDelete"
        >删除</button>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!loading && works.length === 0}}">
      <text class="icon">📭</text>
      <text>暂无作品，点击上方添加</text>
    </view>

    <view class="loading-wrap" wx:if="{{loading}}">
      <text class="icon">⏳</text>
      <text>加载中...</text>
    </view>
  </view>

  <!-- ========== 结果详情 ========== -->
  <view class="tab-content" wx:if="{{activeTab === 'results'}}">
    <view class="refresh-bar" style="margin-bottom:24rpx">
      <text>📊 实时结果</text>
      <text class="refresh-hint">下拉刷新</text>
    </view>

    <view class="detail-list" wx:if="{{results.length > 0}}">
      <view wx:for="{{results}}" wx:key="id" class="detail-item">
        <view class="d-rank">
          <text class="d-num {{index < 3 ? 'top' : ''}}">{{index + 1}}</text>
        </view>
        <image class="d-img" src="{{item.image_data}}" mode="aspectFill" />
        <view class="d-info">
          <text class="d-title">{{item.title}}</text>
          <text class="d-meta">票数: {{item.score}} 票</text>
        </view>
        <view class="d-bar">
          <view class="d-bar-fill" style="width: {{maxScore > 0 ? (item.score / maxScore * 100) : 0}}%"></view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!loading && results.length === 0}}">
      <text class="icon">📊</text>
      <text>暂无投票数据</text>
    </view>
  </view>

  <!-- ========== 颁奖典礼 ========== -->
  <view class="tab-content" wx:if="{{activeTab === 'awards'}}">
    <view class="awards-page" wx:if="{{results.length >= 3 && !awardsAnimating}}">
      <!-- 启动按钮 -->
      <button class="awards-start-btn" bindtap="startAwards">🎬 开始颁奖典礼</button>
      <view class="awards-preview">
        <text class="awards-hint">准备揭晓前三名...</text>
        <view class="awards-top3">
          <view class="awards-top-item" wx:for="{{results}}" wx:key="id" wx:if="{{index < 3}}">
            <image class="at-img" src="{{item.image_data}}" mode="aspectFill" />
            <text class="at-name">{{item.title}}</text>
            <text class="at-score">{{item.score}} 票</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{awardsAnimating}}">
      <view class="awards-stage">
        <text class="stage-title">🏆 颁奖典礼 🏆</text>
        <text class="stage-subtitle">投票作品大赛</text>

        <!-- 第3名 -->
        <view class="award-card bronze {{revealStep >= 1 ? 'revealed' : ''}}" wx:if="{{results[2]}}">
          <text class="award-medal">🥉</text>
          <text class="award-label">第三名</text>
          <image class="award-img" src="{{results[2].image_data}}" mode="aspectFill" />
          <text class="award-title">{{results[2].title}}</text>
          <text class="award-score">{{results[2].score}} 票</text>
          <view class="award-burst" wx:if="{{revealStep >= 1}}"></view>
        </view>

        <!-- 第1名 -->
        <view class="award-card gold {{revealStep >= 3 ? 'revealed' : ''}}" wx:if="{{results[0]}}">
          <text class="award-medal">👑🥇</text>
          <text class="award-label">🏆 第一名 🏆</text>
          <image class="award-img big" src="{{results[0].image_data}}" mode="aspectFill" />
          <text class="award-title">{{results[0].title}}</text>
          <text class="award-score">{{results[0].score}} 票</text>
          <view class="award-burst" wx:if="{{revealStep >= 3}}"></view>
        </view>

        <!-- 第2名 -->
        <view class="award-card silver {{revealStep >= 2 ? 'revealed' : ''}}" wx:if="{{results[1]}}">
          <text class="award-medal">🥈</text>
          <text class="award-label">第二名</text>
          <image class="award-img" src="{{results[1].image_data}}" mode="aspectFill" />
          <text class="award-title">{{results[1].title}}</text>
          <text class="award-score">{{results[1].score}} 票</text>
          <view class="award-burst" wx:if="{{revealStep >= 2}}"></view>
        </view>
      </view>

      <button class="awards-reset-btn" bindtap="resetAwards">重新播放</button>
    </view>

    <view class="empty-state" wx:if="{{results.length < 3 && !loading}}">
      <text class="icon">🏆</text>
      <text>至少需要3件作品才能颁奖</text>
    </view>
  </view>

  <!-- ========== 添加作品弹窗 ========== -->
  <view class="modal-mask" wx:if="{{showAdd}}" bindtap="closeModal">
    <view class="modal-content" catchtap="">
      <text class="modal-title">添加新作品</text>
      
      <view class="form-group">
        <text class="form-label">作品图片</text>
        <view class="img-picker" bindtap="chooseImage">
          <image wx:if="{{addForm.image}}" class="picked-img" src="{{addForm.image}}" mode="aspectFill" />
          <view wx:else class="picker-empty">
            <text class="picker-icon">📷</text>
            <text>点击选择图片</text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">作品名称</text>
        <input 
          class="form-input" 
          placeholder="请输入作品名称"
          value="{{addForm.title}}"
          bindinput="onTitleInput"
        />
      </view>

      <view class="form-group">
        <text class="form-label">作者（选填）</text>
        <input 
          class="form-input" 
          placeholder="请输入作者名"
          value="{{addForm.author}}"
          bindinput="onAuthorInput"
        />
      </view>

      <view class="modal-btns">
        <button class="modal-btn cancel" bindtap="closeModal">取消</button>
        <button 
          class="modal-btn confirm"
          bindtap="doAddWork"
          disabled="{{!addForm.image || !addForm.title || addingWork}}"
        >{{addingWork ? '添加中...' : '确认添加'}}</button>
      </view>
    </view>
  </view>

  <!-- ========== 删除确认弹窗 ========== -->
  <view class="modal-mask" wx:if="{{showDelete}}" bindtap="closeModal">
    <view class="modal-content" catchtap="">
      <text class="modal-title">确认删除</text>
      <text class="confirm-text">确定要删除作品「{{deleteTarget.title}}」吗？此操作不可撤销。</text>
      <view class="modal-btns">
        <button class="modal-btn cancel" bindtap="closeModal">取消</button>
        <button class="modal-btn confirm danger" bindtap="doDelete">确认删除</button>
      </view>
    </view>
  </view>
</view>

