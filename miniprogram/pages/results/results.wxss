.page {
  padding: 24rpx;
  padding-bottom: 100rpx;
}

/* 刷新栏 */
.refresh-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  font-size: 28rpx;
  color: #666;
}

/* 领奖台 */
.podium {
  margin-bottom: 32rpx;
}

.podium-row {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 16rpx;
}

.podium-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  flex: 1;
  max-width: 220rpx;
}

.podium-item.first {
  order: 0;
}

.podium-item.second {
  order: -1;
}

.podium-item.third {
  order: 2;
}

.podium-rank {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.podium-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
  border: 4rpx solid #eee;
}

.podium-img.crown {
  width: 150rpx;
  height: 150rpx;
  border-color: #ffc107;
  border-width: 6rpx;
}

.podium-img.silver {
  border-color: #bdbdbd;
}

.podium-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.podium-score {
  font-size: 28rpx;
  font-weight: 700;
  color: #c62828;
  margin-top: 6rpx;
}

.podium-bar {
  width: 100%;
  height: 16rpx;
  border-radius: 8rpx;
  margin-top: 12rpx;
}

.podium-bar.gold {
  height: 100rpx;
  background: linear-gradient(to top, #ffc107, #ffecb3);
}

.podium-bar.silver {
  height: 70rpx;
  background: linear-gradient(to top, #bdbdbd, #eeeeee);
}

.podium-bar.bronze {
  height: 50rpx;
  background: linear-gradient(to top, #cd7f32, #f4d0a0);
}

/* 排行榜 */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.rank-index {
  width: 60rpx;
  text-align: center;
  flex-shrink: 0;
}

.rank-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #999;
}

.rank-num.top {
  color: #c62828;
}

.rank-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
  margin: 0 16rpx;
}

.rank-info {
  flex: 1;
  overflow: hidden;
  margin-right: 16rpx;
}

.rank-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-author {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.rank-bar-wrap {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  margin-right: 16rpx;
  overflow: hidden;
}

.rank-bar {
  height: 100%;
  background: linear-gradient(90deg, #c62828, #ef5350);
  border-radius: 6rpx;
  min-width: 4rpx;
}

.rank-score {
  font-size: 28rpx;
  font-weight: 700;
  color: #c62828;
  flex-shrink: 0;
  width: 80rpx;
  text-align: right;
}
