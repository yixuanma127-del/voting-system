<view class="page">

  <!-- 活动选择器 -->
  <view class="event-selector">
    <picker 
      range="{{eventNames}}" 
      value="{{currentEventIndex}}" 
      bindchange="onEventChange"
      class="event-picker"
    >
      <view class="event-picker-display">
        <text class="event-label">当前活动：</text>
        <text class="event-name">{{currentEventName}}</text>
        <text class="event-arrow">▾</text>
      </view>
    </picker>
  </view>

  <!-- 已投票提示 -->
  <view class="voted-banner" wx:if="{{hasVoted}}">
    <text class="voted-icon">✅</text>
    <text class="voted-text">您在本活动中已投过票，感谢参与！</text>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载作品中...</text>
  </view>

  <!-- 作品网格 -->
  <view class="works-grid" wx:if="{{!loading && works.length > 0}}">

    <view 
      wx:for="{{works}}" 
      wx:key="id"
      class="work-card {{selectedMap[item.id] !== undefined ? 'selected' : ''}}"
      bindtap="{{hasVoted ? '' : 'selectWork'}}"
      data-id="{{item.id}}"
      data-title="{{item.title}}"
    >

      <!-- 缩略图 -->
      <view class="work-img-wrap">
        <image wx:if="{{item.image_data}}" src="{{item.image_data}}" mode="aspectFill" class="work-img" />
        <view wx:else class="work-img-placeholder">🎨</view>

        <!-- 排名标记 -->
        <view class="rank-badge" wx:if="{{selectedMap[item.id] !== undefined}}">
          {{rankLabels[selectedMap[item.id]]}}
        </view>
      </view>

      <!-- 作品信息 -->
      <view class="work-info">
        <text class="work-title">{{item.title}}</text>
        <text class="work-author" wx:if="{{item.author}}">{{item.author}}</text>
      </view>

    </view>

  </view>

  <!-- 无作品提示 -->
  <view class="empty" wx:if="{{!loading && works.length === 0}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">该活动暂无作品</text>
  </view>

  <!-- 当前排名预览 -->
  <view class="ranking-preview" wx:if="{{selectedOrder.length > 0 && !hasVoted}}">
    <view class="ranking-header">
      <text class="ranking-title">您选择的排名：</text>
      <text class="ranking-clear" bindtap="clearSelections">清空重选</text>
    </view>
    <view class="ranking-list">
      <view class="ranking-item" wx:for="{{selectedOrder}}" wx:key="id">
        <text class="ranking-num">{{rankLabels[index]}}</text>
        <text class="ranking-name">{{item.title}}</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-footer" wx:if="{{!hasVoted}}">
    <button 
      class="submit-btn {{selectedOrder.length === 5 ? 'active' : ''}}"
      disabled="{{selectedOrder.length < 5 || submitting}}"
      bindtap="submitVote"
    >
      {{submitting ? '提交中...' : (selectedOrder.length < 5 ? '请选择5件作品再提交 (' + selectedOrder.length + '/5)' : '提交投票')}}
    </button>
  </view>

</view>
